<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Arkaplan takibinin OEM pil yoneticileri tarafindan oldurulmesini
         azaltmak icin kullaniciya istisna istemi gosterebilmek amaciyla. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Gunluk yedekleme e-postasinin SMTP ile gonderilebilmesi icin. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- GitHub uzerinden guncelleme: indirilen APK'yi kurabilmek icin. Normal
         izin dialoguyla ISTENEMEZ, kullanici Ayarlar > Bilinmeyen kaynaklar'dan
         acikca vermeli (bkz. util/UpdateInstaller.kt). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Uygulama Kullanimi ekrani: normal izin dialoguyla ISTENEMEZ, kullanici
         Ayarlar > Ozel erisim > Kullanim erisimi'nden acikca vermeli. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Ebeveyn-denetim: arama/mesaj ozeti, konum/guvenli bolge (normal runtime
         izin dialoguyla istenir). Bildirim erisimi (asagida) ozel bir izindir. -->
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <!-- Android 11+ paket gorunurlugu kisitlamasi: bu deklarasyon olmadan
         PackageManager.getInstalledApplications() gercek cihazlarda neredeyse
         bos donuyor, bu yuzden Uygulama Kilidi'ndeki "Uygulama Ekle" listesi
         calismıyordu. Sadece baslatilabilir (launcher) uygulamalari gormek
         yeterli, QUERY_ALL_PACKAGES gibi daha genis bir izin gerekmiyor. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".StudyTrackerApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.DersCalismaTakibi">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.DersCalismaTakibi">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.StudyForegroundService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- Bildirim log - ozel izin, kullanici Ayarlar > Bildirim erisimi'nden
             acikca vermeli (Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS). -->
        <service
            android:name=".service.AppNotificationListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Uygulama Kilidi - ozel izin, kullanici Ayarlar > Erisilebilirlik'ten
             acikca vermeli (Settings.ACTION_ACCESSIBILITY_SETTINGS). -->
        <service
            android:name=".service.AppBlockAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <activity
            android:name=".BlockedActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
