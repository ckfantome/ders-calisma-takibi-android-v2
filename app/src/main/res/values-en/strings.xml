    <!-- AppBlockScreen -->
    <string name="app_block_title">App Lock</string>
    <string name="app_block_student_readonly">You\'re in student mode: this screen is read-only. Switch to administrator mode from the lock icon at the top to change it.</string>
    <string name="app_block_accessibility_needed">Accessibility permission needed</string>
    <string name="app_block_accessibility_explanation">To detect when a blocked app comes to the foreground, you need to explicitly turn on the \"Accessibility Service\" from Settings. By default this service does NOT read screen content, it only sees which app is in the foreground - if you separately turn on Keystroke Logging below, it also starts recording typed text.</string>
    <string name="app_block_oem_restrictive_note">On this phone brand (Oppo/Xiaomi/Huawei/Vivo) the system service can turn itself off over time even if the permission is on - you also need to add the app to the Autostart list below.</string>
    <string name="app_block_open_autostart_settings">Open Autostart Settings</string>
    <string name="app_block_exam_mode_title">Exam/Homework Mode</string>
    <string name="app_block_exam_mode_explanation">While on, EVERYTHING is blocked regardless of the Locked Apps list - only apps in the \'Allowed Apps\' list below and required apps (home screen/phone) can be opened.</string>
    <string name="app_block_screen_pinning_title">+ Fully Pin the Screen</string>
    <string name="app_block_screen_pinning_explanation">While Exam Mode is on, the phone is locked to ONLY this app - NOTHING ELSE can be opened, including the \'Allowed Apps\' list (home screen/Recents also disabled). Not affected by the OEM turning off the Accessibility permission.</string>
    <string name="app_block_allowed_apps_title">Allowed Apps (During Exam Mode)</string>
    <string name="app_block_allowed_apps_explanation">While Exam/Homework Mode is on, no app other than these can be opened (e.g. Calculator).</string>
